#!/bin/sh
# marmot — the cl-marmot command line client (SBCL).
# Dependencies: the modus-lisp libraries (natrium, secp256k1-fast, seal,
# cl-nostr) in $MODUS_LISP, ../modus-lisp or ~/modus-lisp, and Quicklisp for
# cl-nostr's own dependencies.  See load-deps.lisp.
here="$(cd "$(dirname "$0")/.." && pwd)"
exec sbcl --noinform --non-interactive --no-userinit \
  --load "$here/load-deps.lisp" \
  --eval "(let ((*standard-output* (make-broadcast-stream)) (*error-output* (make-broadcast-stream))) (handler-bind ((warning (function muffle-warning))) (ql:quickload :cl-marmot :silent t)))" \
  --eval '(sb-ext:exit :code (marmot:cli-main (rest sb-ext:*posix-argv*)) :abort t)' \
  --end-toplevel-options "$@"
