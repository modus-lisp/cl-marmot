;;;; mls-vector-tests.lisp — the MLS working group interop test vectors
;;;;
;;;; https://github.com/mlswg/mls-implementations/tree/main/test-vectors
;;;; Only cipher suite 1 (the Marmot suite) is exercised.  Vectors that need a
;;;; feature cl-marmot deliberately does not implement (PSKs) are skipped and
;;;; counted, so a skip can never pass silently as a success.

(in-package #:cl-marmot/test)

(defun load-vectors (name)
  (let ((path (vector-path name)))
    (if (probe-file path)
        (with-open-file (in path :external-format :utf-8)
          (let ((text (make-string (file-length in))))
            (let ((n (read-sequence text in)))
              (remove-if-not (lambda (v) (or (not (jobj-p v)) (eql (jget v "cipher_suite" 1) 1)))
                             (coerce (parse-json (subseq text 0 n)) 'list)))))
        (progn (format t "~&;; missing vector file ~A~%" path) '()))))

(defun jhex (obj key)
  (let ((v (jget obj key)))
    (and (stringp v) (hex->octets v))))

(defvar *skipped* '())
(defun skip (why) (push why *skipped*))

;;; ---------------------------------------------------------------------------

(deftest mls-crypto-basics ()
  (dolist (v (load-vectors "crypto-basics.json"))
    (let ((x (jget v "ref_hash")))
      (is-hex (jget x "out") (ref-hash (jget x "label") (jhex x "value")) "RefHash"))
    (let ((x (jget v "expand_with_label")))
      (is-hex (jget x "out") (expand-with-label (jhex x "secret") (jget x "label")
                                                (jhex x "context") (jget x "length"))
              "ExpandWithLabel"))
    (let ((x (jget v "derive_secret")))
      (is-hex (jget x "out") (derive-secret (jhex x "secret") (jget x "label")) "DeriveSecret"))
    (let ((x (jget v "derive_tree_secret")))
      (is-hex (jget x "out") (derive-tree-secret (jhex x "secret") (jget x "label")
                                                 (jget x "generation") (jget x "length"))
              "DeriveTreeSecret"))
    (let ((x (jget v "sign_with_label")))
      (is (verify-with-label (jhex x "pub") (jget x "label") (jhex x "content") (jhex x "signature"))
          "VerifyWithLabel")
      (is (verify-with-label (jhex x "pub") (jget x "label") (jhex x "content")
                             (sign-with-label (jhex x "priv") (jget x "label") (jhex x "content")))
          "SignWithLabel round trip"))
    (let ((x (jget v "encrypt_with_label")))
      (is-hex (jget x "plaintext")
              (decrypt-with-label (jhex x "priv") (jget x "label") (jhex x "context")
                                  (make-hpke-ciphertext :kem-output (jhex x "kem_output")
                                                        :ciphertext (jhex x "ciphertext")))
              "DecryptWithLabel")
      (let ((ct (encrypt-with-label (jhex x "pub") (jget x "label") (jhex x "context") (jhex x "plaintext"))))
        (is-hex (jget x "plaintext")
                (decrypt-with-label (jhex x "priv") (jget x "label") (jhex x "context") ct)
                "EncryptWithLabel round trip")))))

(deftest mls-tree-math ()
  (dolist (v (load-vectors "tree-math.json"))
    (let ((n (jget v "n_leaves")))
      (is-equal (jget v "n_nodes") (tm-node-width n))
      (is-equal (jget v "root") (tm-root n))
      (loop for i from 0
            for l across (jget v "left") for r across (jget v "right")
            for p across (jget v "parent") for s across (jget v "sibling")
            do (is-equal l (if (or (evenp i)) :null (tm-left i)) (format nil "left ~D/~D" i n))
               (is-equal r (if (evenp i) :null (tm-right i)) (format nil "right ~D/~D" i n))
               (is-equal p (if (= i (tm-root n)) :null (tm-parent i n)) (format nil "parent ~D/~D" i n))
               (is-equal s (if (= i (tm-root n)) :null (tm-sibling i n)) (format nil "sibling ~D/~D" i n))))))

(deftest mls-secret-tree ()
  (dolist (v (load-vectors "secret-tree.json"))
    (let ((sd (jget v "sender_data")))
      (multiple-value-bind (k n) (sender-data-key-nonce (jhex sd "sender_data_secret") (jhex sd "ciphertext"))
        (is-hex (jget sd "key") k "sender data key")
        (is-hex (jget sd "nonce") n "sender data nonce")))
    (let* ((leaves (jget v "leaves"))
           (st (make-secret-tree (jhex v "encryption_secret") (length leaves))))
      (loop for leaf across leaves
            for i from 0
            do (loop for g across leaf
                     do (let ((gen (jget g "generation")))
                          (multiple-value-bind (k n) (secret-tree-key-for st i :application gen)
                            (is-hex (jget g "application_key") k)
                            (is-hex (jget g "application_nonce") n))
                          (multiple-value-bind (k n) (secret-tree-key-for st i :handshake gen)
                            (is-hex (jget g "handshake_key") k)
                            (is-hex (jget g "handshake_nonce") n))))))))

(deftest mls-key-schedule ()
  (dolist (v (load-vectors "key-schedule.json"))
    (let ((init (jhex v "initial_init_secret"))
          (group-id (jhex v "group_id")))
      (loop for e across (jget v "epochs")
            for epoch from 0
            do (let* ((gc (make-group-context :version 1 :cipher-suite 1 :group-id group-id :epoch epoch
                                              :tree-hash (jhex e "tree_hash")
                                              :confirmed-transcript-hash (jhex e "confirmed_transcript_hash")
                                              :extensions '()))
                      (gco (group-context-octets gc)))
                 (is-hex (jget e "group_context") gco "GroupContext encoding")
                 (let* ((joiner (joiner-secret-from init (jhex e "commit_secret") gco))
                        (s (epoch-secrets-from-joiner joiner (jhex e "psk_secret") gco)))
                   (is-hex (jget e "joiner_secret") joiner "joiner")
                   (is-hex (jget e "welcome_secret") (epoch-secrets-welcome-secret s) "welcome")
                   (is-hex (jget e "init_secret") (epoch-secrets-init-secret s) "init")
                   (is-hex (jget e "sender_data_secret") (epoch-secrets-sender-data-secret s))
                   (is-hex (jget e "encryption_secret") (epoch-secrets-encryption-secret s))
                   (is-hex (jget e "exporter_secret") (epoch-secrets-exporter-secret s))
                   (is-hex (jget e "external_secret") (epoch-secrets-external-secret s))
                   (is-hex (jget e "confirmation_key") (epoch-secrets-confirmation-key s))
                   (is-hex (jget e "membership_key") (epoch-secrets-membership-key s))
                   (is-hex (jget e "resumption_psk") (epoch-secrets-resumption-psk s))
                   (is-hex (jget e "epoch_authenticator") (epoch-secrets-epoch-authenticator s))
                   (is-hex (jget e "external_pub")
                           (nth-value 1 (hpke-derive-key-pair (epoch-secrets-external-secret s))))
                   (let ((x (jget e "exporter")))
                     (is-hex (jget x "secret")
                             (mls-exporter (epoch-secrets-exporter-secret s) (jget x "label")
                                           (jhex x "context") (jget x "length"))
                             "exporter"))
                   (setf init (epoch-secrets-init-secret s))))))))

(deftest mls-psk-secret ()
  (dolist (v (load-vectors "psk_secret.json"))
    (is-hex (jget v "psk_secret")
            (psk-secret (loop for p across (jget v "psks")
                              collect (cons (make-pre-shared-key-id :type 1 :psk-id (jhex p "psk_id")
                                                                    :psk-nonce (jhex p "psk_nonce"))
                                            (jhex p "psk")))))))

(deftest mls-transcript-hashes ()
  (dolist (v (load-vectors "transcript-hashes.json"))
    (let* ((ac (make-reader (jhex v "authenticated_content")))
           (wf (r-u16 ac))
           (fc (decode-framed-content ac))
           (auth (decode-auth-data ac (framed-content-content-type fc))))
      (is (reader-done-p ac))
      (let ((confirmed (confirmed-transcript-hash-next (jhex v "interim_transcript_hash_before") wf fc
                                                       (auth-data-signature auth))))
        (is-hex (jget v "confirmed_transcript_hash_after") confirmed)
        (is (octets= (mls-mac (jhex v "confirmation_key") confirmed) (auth-data-confirmation-tag auth))
            "confirmation tag")
        (is-hex (jget v "interim_transcript_hash_after")
                (interim-transcript-hash-next confirmed (auth-data-confirmation-tag auth)))))))

(defun %tree-from-hex (hex)
  (make-ratchet-tree-from-nodes (decode-exactly (hex->octets hex) #'decode-ratchet-tree "tree")))

(deftest mls-tree-validation ()
  (dolist (v (load-vectors "tree-validation.json"))
    (let ((tree (%tree-from-hex (jget v "tree")))
          (cache (make-hash-table)))
      (loop for h across (jget v "tree_hashes")
            for i from 0
            do (is-hex h (rt-tree-hash tree i cache) (format nil "tree hash node ~D" i)))
      (loop for r across (jget v "resolutions")
            for i from 0
            do (is-equal (coerce r 'list) (rt-resolution tree i) (format nil "resolution ~D" i)))
      (is (rt-verify-parent-hashes tree) "parent hashes")
      (is (handler-case (validate-tree-leaves tree (jhex v "group_id") '())
            (mls-error (c) (note-failure "~A" c) nil))
          "leaf signatures"))))

(deftest mls-tree-operations ()
  (dolist (v (load-vectors "tree-operations.json"))
    (let* ((tree (%tree-from-hex (jget v "tree_before")))
           (p (tls-deserialize 'proposal (jhex v "proposal")))
           (sender (jget v "proposal_sender")))
      (is-hex (jget v "tree_hash_before") (rt-tree-hash tree))
      (cond ((= (proposal-type p) +prop-add+)
             (rt-add-leaf tree (key-package-leaf-node (proposal-key-package p))))
            ((= (proposal-type p) +prop-update+)
             (rt-update-leaf tree sender (proposal-leaf-node p)))
            ((= (proposal-type p) +prop-remove+)
             (rt-remove-leaf tree (proposal-removed p))
             (rt-truncate tree)))
      (is-hex (jget v "tree_hash_after") (rt-tree-hash tree))
      (is-hex (jget v "tree_after")
              (with-writer (w) (encode-ratchet-tree w (rt-export-nodes tree)))))))

(deftest mls-treekem ()
  (dolist (v (load-vectors "treekem.json"))
    (let ((group-id (jhex v "group_id")))
      (loop for up across (jget v "update_paths")
            do (let* ((tree (%tree-from-hex (jget v "ratchet_tree")))
                      (sender (jget up "sender"))
                      (path (tls-deserialize 'update-path (jhex up "update_path")))
                      (fdp (handler-case (merge-update-path tree sender path)
                             (mls-error (c) (note-failure "merge: ~A" c) nil))))
                 (is-hex (jget up "tree_hash_after") (rt-tree-hash tree) "tree hash after")
                 (let ((ctx (group-context-octets
                             (make-group-context :version 1 :cipher-suite 1 :group-id group-id
                                                 :epoch (jget v "epoch")
                                                 :tree-hash (rt-tree-hash tree)
                                                 :confirmed-transcript-hash (jhex v "confirmed_transcript_hash")
                                                 :extensions '()))))
                   (loop for lp across (jget v "leaves_private")
                         do (let* ((own (jget lp "index"))
                                   (expected (aref (jget up "path_secrets") own))
                                  (sks (make-hash-table)))
                              (unless (= own sender)
                                ;; private keys: leaf + given path secrets
                                (setf (gethash (* 2 own) sks) (jhex lp "encryption_priv"))
                                (loop for ps across (jget lp "path_secrets")
                                      do (setf (gethash (jget ps "node") sks)
                                               (hpke-derive-key-pair
                                                (derive-secret (jhex ps "path_secret") "node"))))
                                (handler-case
                                    (multiple-value-bind (keys commit-secret first-ps)
                                        (decrypt-update-path tree own fdp path sks ctx '())
                                      (declare (ignore keys))
                                      (is-hex expected first-ps (format nil "path secret leaf ~D sender ~D" own sender))
                                      (is-hex (jget up "commit_secret") commit-secret "commit secret"))
                                  (mls-error (c) (note-failure "decrypt leaf ~D: ~A" own c))))))))))))

(deftest mls-message-protection ()
  (dolist (v (load-vectors "message-protection.json"))
    (let* ((gc (make-group-context :version 1 :cipher-suite 1 :group-id (jhex v "group_id")
                                   :epoch (jget v "epoch") :tree-hash (jhex v "tree_hash")
                                   :confirmed-transcript-hash (jhex v "confirmed_transcript_hash")
                                   :extensions '()))
           (sig-pub (jhex v "signature_pub")))
      (flet ((unprotect (msg-hex)
               (let ((m (tls-deserialize 'mls-message (hex->octets msg-hex))))
                 (if (= (mls-message-wire-format m) +wf-public-message+)
                     (let* ((pm (mls-message-body m))
                            (fc (public-message-content pm)))
                       (is (verify-framed-content sig-pub +wf-public-message+ fc gc
                                                  (auth-data-signature (public-message-auth pm)))
                           "public signature")
                       (when (public-message-membership-tag pm)
                         (is (octets= (membership-tag (jhex v "membership_key") +wf-public-message+ fc
                                                      (public-message-auth pm) gc)
                                      (public-message-membership-tag pm))
                             "membership tag"))
                       fc)
                     (let ((st (make-secret-tree (jhex v "encryption_secret") 2)))
                       (multiple-value-bind (fc auth)
                           (decrypt-private-message (mls-message-body m) st (jhex v "sender_data_secret"))
                         (is (verify-framed-content sig-pub +wf-private-message+ fc gc
                                                    (auth-data-signature auth))
                             "private signature")
                         fc))))))
        (let ((fc (unprotect (jget v "application_priv"))))
          (is-hex (jget v "application") (framed-content-application-data fc)))
        (dolist (k '("proposal_pub" "proposal_priv"))
          (is-hex (jget v "proposal") (tls-serialize 'proposal (framed-content-proposal (unprotect (jget v k)))) k))
        (dolist (k '("commit_pub" "commit_priv"))
          (is-hex (jget v "commit") (tls-serialize 'commit (framed-content-commit (unprotect (jget v k)))) k))))))

(deftest mls-messages-roundtrip ()
  (let ((n 0))
    (dolist (v (load-vectors "messages.json"))
      (loop for (key . type) in '(("mls_welcome" . mls-message) ("mls_group_info" . mls-message)
                                  ("mls_key_package" . mls-message) ("group_secrets" . group-secrets)
                                  ("add_proposal" . key-package) ("update_proposal" . leaf-node)
                                  ("group_context_extensions_proposal" . extension-list)
                                  ("commit" . commit) ("public_message_application" . mls-message)
                                  ("public_message_proposal" . mls-message) ("public_message_commit" . mls-message)
                                  ("private_message" . mls-message))
            for hex = (jget v key)
            when (stringp hex)
              do (incf n)
                 (let ((bytes (hex->octets hex)))
                   (handler-case
                       (unless (octets= bytes (tls-serialize type (tls-deserialize type bytes)))
                         (note-failure "~A does not round-trip" key))
                     (error (c) (note-failure "~A: ~A" key c))))))
    (is (> n 0))))

(defun %bundle-from-vector (v)
  (make-key-package-bundle
   :key-package (mls-message-body (tls-deserialize 'mls-message (jhex v "key_package")))
   :init-sk (jhex v "init_priv") :leaf-sk (jhex v "encryption_priv") :sig-sk (jhex v "signature_priv")))

(deftest mls-welcome ()
  (dolist (v (load-vectors "welcome.json"))
    ;; no ratchet tree is given: check decryption, signature and confirmation tag only
    (let* ((kp (mls-message-body (tls-deserialize 'mls-message (jhex v "key_package"))))
           (w (mls-message-body (tls-deserialize 'mls-message (jhex v "welcome"))))
           (egs (find (key-package-ref kp) (welcome-secrets w) :key #'encrypted-group-secrets-new-member
                                                               :test #'octets=)))
      (is egs "our KeyPackageRef is in the Welcome")
      (when egs
        (let* ((gs (tls-deserialize 'group-secrets
                                    (decrypt-with-label (jhex v "init_priv") "Welcome"
                                                        (welcome-encrypted-group-info w)
                                                        (encrypted-group-secrets-encrypted-group-secrets egs))))
               (member (hkdf-extract (group-secrets-joiner-secret gs) (zero-secret)))
               (ws (derive-secret member "welcome")))
          (multiple-value-bind (key nonce) (welcome-key-nonce ws)
            (let* ((gi (tls-deserialize 'group-info (mls-aead-decrypt key nonce (welcome-encrypted-group-info w)
                                                                      (make-octets 0))))
                   (gco (group-context-octets (group-info-group-context gi)))
                   (s (epoch-secrets-from-joiner (group-secrets-joiner-secret gs) (zero-secret) gco)))
              (is (verify-with-label (jhex v "signer_pub") "GroupInfoTBS" (group-info-tbs gi)
                                     (group-info-signature gi))
                  "GroupInfo signature")
              (is (octets= (group-info-confirmation-tag gi)
                           (mls-mac (epoch-secrets-confirmation-key s)
                                    (group-context-confirmed-transcript-hash (group-info-group-context gi))))
                  "confirmation tag"))))))))

(defun %run-passive (file)
  (dolist (v (load-vectors file))
    (progn
        (handler-case
            (let ((g (join-from-welcome
                      (mls-message-body (tls-deserialize 'mls-message (jhex v "welcome")))
                      (%bundle-from-vector v)
                      :ratchet-tree-nodes (let ((rt (jget v "ratchet_tree")))
                                            (and (stringp rt)
                                                 (decode-exactly (hex->octets rt) #'decode-ratchet-tree "tree")))
                      :external-psks (loop for p across (jget v "external_psks")
                                           collect (cons (jhex p "psk_id") (jhex p "psk"))))))
              (is-hex (jget v "initial_epoch_authenticator")
                      (epoch-secrets-epoch-authenticator (mls-group-secrets g)) (format nil "~A join" file))
              (loop for e across (jget v "epochs")
                    for i from 1
                    do (loop for p across (jget e "proposals")
                             do (process-message g (hex->octets p)))
                       (let ((r (process-message g (jhex e "commit"))))
                         (setf g (getf r :new-group)))
                       (is-hex (jget e "epoch_authenticator")
                               (epoch-secrets-epoch-authenticator (mls-group-secrets g))
                               (format nil "~A epoch ~D" file i))))
          (mls-error (c)
            (if (search "PSK" (mls-error-message c))
                (skip (format nil "~A: ~A" file c))
                (note-failure "~A: ~A" file c)))))))

(deftest mls-passive-client-welcome () (%run-passive "passive-client-welcome.json"))
(deftest mls-passive-client-commit () (%run-passive "passive-client-handling-commit.json"))
(deftest mls-passive-client-random () (%run-passive "passive-client-random.json"))

(deftest mls-zz-report-skips ()
  (when *skipped*
    (format t "~&;; ~D vectors skipped (unsupported feature):~%~{;;   ~A~%~}"
            (length *skipped*) (remove-duplicates *skipped* :test #'string=)))
  (setf *skipped* '())
  (is t))
